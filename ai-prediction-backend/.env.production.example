# Production template — copy values into Azure App Service / secret store only.
# Never commit real credentials. Never put DB/JWT/email secrets in Next.js or NEXT_PUBLIC_*.
# Do not switch production DATABASE_URL or EMAIL_PROVIDER until explicitly approved.

NODE_ENV=production
PORT=4000

# --- Neon PostgreSQL ---
# Runtime (Prisma Client / Nest): use the Neon POOLED connection string (-pooler host).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/academic_sentinel?sslmode=require&pgbouncer=true&connection_limit=10&schema=public
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/academic_sentinel?sslmode=require&schema=public

JWT_ACCESS_SECRET=replace-with-at-least-32-cryptographically-random-bytes
JWT_ACCESS_TTL=10m
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Required in production so Admin/Main Next.js SSR can read API session cookies.
# Must be exactly academicsentinel.live (shared by api, admin, and www).
COOKIE_DOMAIN=academicsentinel.live

# Exact production browser origins only (comma-separated, no trailing slash).
CORS_ORIGINS=https://www.academicsentinel.live,https://admin.academicsentinel.live

# Private ML base URL (not public DNS). Required only when ML_INTEGRATION_ENABLED=true.
ML_INTEGRATION_ENABLED=false
ML_SERVICE_URL=http://ml.internal:8000
ML_SERVICE_TOKEN=replace-with-a-shared-random-secret-of-at-least-32-chars
ML_SERVICE_TIMEOUT_MS=3000
ML_SERVICE_RETRIES=2
ML_UNIVERSITY_POLICY_APPROVED=false
ML_PREDICTION_PERSISTENCE_ENABLED=false
DEMO_PREDICTION_ENABLED=false
STUDENT_PREDICTIONS_ENABLED=false

STUDENT_SELF_REGISTRATION_ENABLED=false
TEACHER_SELF_REGISTRATION_ENABLED=false

# --- Email ---
# Keep EMAIL_POLICY_APPROVED=false and SMTP_ENABLED=false until institutional approval.
# EMAIL_PROVIDER=smtp | brevo | resend. Switch providers only when approved.
# EMAIL_TEST_RECIPIENTS: verified test mailboxes only (never student risk alert addresses).
EMAIL_POLICY_APPROVED=false
SMTP_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_TEST_RECIPIENTS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Academic Sentinel
RESEND_API_KEY=
EMAIL_FROM=Academic Sentinel <admin@academicsentinel.live>
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Academic Sentinel
BREVO_TIMEOUT_MS=15000
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_AUTO_RETRY=false

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
