NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://academic_sentinel:CHANGE_ME@localhost:5432/academic_sentinel?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL=10m
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TOKEN=replace-with-a-shared-random-secret
ML_SERVICE_TIMEOUT_MS=3000
ML_SERVICE_RETRIES=2
ML_UNIVERSITY_POLICY_APPROVED=false
ML_PREDICTION_PERSISTENCE_ENABLED=false
STUDENT_PREDICTIONS_ENABLED=false
STUDENT_SELF_REGISTRATION_ENABLED=true
TEACHER_SELF_REGISTRATION_ENABLED=false
EMAIL_POLICY_APPROVED=false
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Academic Sentinel
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_MS=15000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_AUTO_RETRY=false
EMAIL_MAX_ATTEMPTS=3
EMAIL_MAX_DISPATCH_ROUNDS=2
EMAIL_RETRY_BACKOFF_MS=60000
EMAIL_STALE_SENDING_MS=300000
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
