NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://academic_sentinel:CHANGE_ME@localhost:5432/academic_sentinel?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL=10m
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TOKEN=replace-with-a-shared-random-secret
STUDENT_PREDICTIONS_ENABLED=false
EMAIL_POLICY_APPROVED=false
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
